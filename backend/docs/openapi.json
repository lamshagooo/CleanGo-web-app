  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {"error":{"type":"string"}}
      },
      "LocationResults": {
        "type": "object",
        "additionalProperties": false,
        "required": ["matches","attribution","attribution_url"],
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["address","latitude","longitude"],
              "properties": {"address":{"type":"string"},"latitude":{"type":"number"},"longitude":{"type":"number"}}
            }
          },
          "attribution": {"type":"string"},
          "attribution_url": {"type":"string","format":"uri"}
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","name","email","role"],
        "properties": {
          "id": {"type":"integer","minimum":1,"maximum":2147483647},
          "name": {"type":"string","maxLength":100,"minLength":1},
          "email": {"type":"string","maxLength":150,"format":"email"},
          "role": {"type":"string","enum":["customer","cleaner","admin"]}
        }
      },
      "UserCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name","email","password","role"],
        "properties": {
          "name": {"type":"string","maxLength":100,"minLength":1},
          "email": {"type":"string","maxLength":150,"format":"email"},
          "password": {
            "type": "string",
            "maxLength": 255,
            "minLength": 8,
            "writeOnly": true,
            "format": "password",
            "description": "At least 8 characters.",
            "example": "example-password"
          },
          "role": {"type":"string","enum":["customer","cleaner","admin"]}
        }
      },
      "UserUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type":"string","maxLength":100,"minLength":1},
          "email": {"type":"string","maxLength":150,"format":"email"},
          "password": {
            "type": "string",
            "maxLength": 255,
            "minLength": 8,
            "writeOnly": true,
            "format": "password",
            "description": "At least 8 characters.",
            "example": "example-password"
          },
          "role": {"type":"string","enum":["customer","cleaner","admin"]}
        },
        "minProperties": 1
      },
      "CleanerProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","user_id","hourly_rate","bio","location","experience_years"],
        "properties": {
          "id": {"type":"integer","minimum":1,"maximum":2147483647},
          "user_id": {"type":"integer","minimum":1,"maximum":2147483647,"description":"ID of a user with the cleaner role."},
          "hourly_rate": {"type":"string","example":"25.00"},
          "bio": {"type":"string","maxLength":16000,"nullable":true},
          "location": {"type":"string","maxLength":100,"nullable":true},
          "experience_years": {"type":"integer","minimum":0,"maximum":2147483647,"default":0}
        }
      },
      "CleanerProfileCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user_id","hourly_rate"],
        "properties": {
          "user_id": {"type":"integer","minimum":1,"maximum":2147483647,"description":"ID of a user with the cleaner role."},
          "hourly_rate": {"type":"number","minimum":0},
          "bio": {"type":"string","maxLength":16000,"nullable":true},
          "location": {"type":"string","maxLength":100,"nullable":true},
          "experience_years": {"type":"integer","minimum":0,"maximum":2147483647,"default":0}
        }
      },
      "CleanerProfileUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {"type":"integer","minimum":1,"maximum":2147483647,"description":"ID of a user with the cleaner role."},
          "hourly_rate": {"type":"number","minimum":0},
          "bio": {"type":"string","maxLength":16000,"nullable":true},
          "location": {"type":"string","maxLength":100,"nullable":true},
          "experience_years": {"type":"integer","minimum":0,"maximum":2147483647,"default":0}
        },
        "minProperties": 1
      },
      "CleaningService": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","name","description","base_price"],
        "properties": {
          "id": {"type":"integer","minimum":1,"maximum":2147483647},
          "name": {"type":"string","maxLength":100,"minLength":1},
          "description": {"type":"string","maxLength":16000,"nullable":true},
          "base_price": {"type":"string","example":"25.00"}
        }
      },
      "CleaningServiceCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name","base_price"],
        "properties": {
          "name": {"type":"string","maxLength":100,"minLength":1},
          "description": {"type":"string","maxLength":16000,"nullable":true},
          "base_price": {"type":"number","minimum":0}
        }
      },
      "CleaningServiceUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type":"string","maxLength":100,"minLength":1},
          "description": {"type":"string","maxLength":16000,"nullable":true},
          "base_price": {"type":"number","minimum":0}
        },
        "minProperties": 1
      },
      "CleanerService": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cleaner_id","service_id"],
        "properties": {
          "cleaner_id": {"type":"integer","minimum":1,"maximum":2147483647},
          "service_id": {"type":"integer","minimum":1,"maximum":2147483647}
        }
      },
      "CleanerServiceCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cleaner_id","service_id"],
        "properties": {
          "cleaner_id": {"type":"integer","minimum":1,"maximum":2147483647},
          "service_id": {"type":"integer","minimum":1,"maximum":2147483647}
        }
      },
      "CleanerServiceUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_id"],
        "properties": {"service_id":{"type":"integer","minimum":1,"maximum":2147483647}}
      },
      "Booking": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","user_id","cleaner_id","service_id","booking_date","booking_time","duration","status"],
        "properties": {
          "id": {"type":"integer","minimum":1,"maximum":2147483647},
          "user_id": {"type":"integer","minimum":1,"maximum":2147483647,"description":"ID of a customer."},
          "cleaner_id": {"type":"integer","minimum":1,"maximum":2147483647},
          "service_id": {"type":"integer","minimum":1,"maximum":2147483647,"description":"The cleaner must offer this service."},
          "booking_date": {"type":"string","format":"date","example":"2027-06-01"},
          "booking_time": {"type":"string","example":"09:30"},
          "duration": {"type":"integer","minimum":1,"maximum":2147483647,"description":"Duration in hours."},
          "status": {"type":"string","enum":["pending","confirmed","completed","cancelled"],"default":"pending"}
        }
      },
      "BookingCreate": {
        "type": "object",
        "additionalProperties": false,
