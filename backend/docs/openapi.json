    "/locations/search": {
      "get": {
        "tags": ["locations"],
        "summary": "Find locations by public address",
        "responses": {
          "200": {
            "description": "Matching locations. An empty matches array means no results.",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/LocationResults"}}}
          },
          "400": {"$ref":"#/components/responses/BadRequest"},
          "429": {"$ref":"#/components/responses/RateLimit"},
          "500": {"$ref":"#/components/responses/ServerError"},
          "502": {"$ref":"#/components/responses/ProviderError"},
          "504": {"$ref":"#/components/responses/ProviderTimeout"}
        },
        "description": "Manual demo search using OpenStreetMap Nominatim. Use public addresses only. Address data © [OpenStreetMap contributors](https://www.openstreetmap.org/copyright). See the [usage policy](https://operations.osmfoundation.org/policies/nominatim/).",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {"type":"string","maxLength":200,"minLength":3},
            "example": "Vijecnica, Sarajevo"
          }
        ]
      }
    }
